    </tabbed-dialog>
    <section id="multiple-slides">
      <title>Multiple slides side-by-side</title>
      <p>Add multiple <xmlelement>image</xmlelement> elements within each <xmlelement>carousel-item</xmlelement></p>
    </section>
<fig>
      <title>Multiple slides side-by-side</title>
      <image href="src/carousel/side-by-side.png" scalefit="yes"/>
