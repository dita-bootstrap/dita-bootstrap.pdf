        <codeblock><coderef href="code/specialization/carousel/item-interval.xml"/></codeblock>
      </section>
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock><coderef href="code/html/carousel/item-interval.xml"/></codeblock>
      </section>
    </tabbed-dialog>
    <section id="disable-touch-swipe">
      <title>Disable touch swiping</title>
      <p>Carousels support swiping left/right on touchscreen devices to move between slides. Add
          <xmlatt>touch="no"</xmlatt> to disable this option.</p>
    </section>
<fig>
      <title>Disable touch swiping</title>
      <image href="src/carousel/disable-touch.png" scalefit="yes"/>
    </fig>
