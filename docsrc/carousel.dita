        <codeblock><coderef href="code/specialization/carousel/non-image-elements.xml"/></codeblock>
      </section>
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock><coderef href="code/html/carousel/non-image-elements.xml"/></codeblock>
