<!DOCTYPE topic PUBLIC "-//DITA Bootstrap//DTD DITA Bootstrap Topic//EN" "bootstrap-topic.dtd">
<topic id="button-group">
  <title>Button group</title>
  <shortdesc>Group a series of buttons together on a single line or stack them in a vertical column.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Button Group</indexterm>
        <indexterm>CSS
          <indexterm><xmlatt>outputclass</xmlatt></indexterm>
        </indexterm>
        <indexterm><xmlelement>div</xmlelement></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body outputclass="language-markup">
    <section>
      <title>Basic example</title>
      <p>Wrap a series of buttons with <xmlelement>xref outputclass="btn-*"</xmlelement> in a <xmlelement>div
          outputclass="btn-group"</xmlelement>
      </p>
    </section>
    <fig>
      <title>Button Group</title>
      <image href="src/button-group/basic-example.png" scalefit="yes"/>
    </fig>
    <tabbed-dialog style="pills" margin="t3">
      <section>
