<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//DITA Bootstrap//DTD DITA Bootstrap Topic//EN" "bootstrap-topic.dtd">
<topic id="swatch">
  <title>Swatch</title>
  <shortdesc>A single-page tour of the components that have PDF equivalents, in the style of a Bootswatch theme
    preview.</shortdesc>
  <body outputclass="language-markup">
    <section id="typography">
      <title>Typography</title>
      <title outputclass="h1">h1. Heading</title>
      <title outputclass="h2">h2. Heading</title>
      <title outputclass="h3">h3. Heading</title>
      <title outputclass="h4">h4. Heading</title>
      <title outputclass="h5">h5. Heading</title>
      <title outputclass="h6">h6. Heading</title>
      <p outputclass="lead">This is a lead paragraph. It stands out from regular paragraphs.</p>
      <p>You can use the mark tag to <ph outputclass="mark">highlight</ph> text, <line-through
        >deleted text</line-through>,
        <u>underlined text</u>, <i>italic text</i> and <b>bold text</b>. This is a
        <xref href="#">default link</xref>.</p>
    </section>

    <section id="buttons">
      <title>Buttons</title>
    </section>
      <p>Solid</p>
      <p>
        <button href="#" color="primary">Primary</button>
        <button href="#" color="secondary">Secondary</button>
        <button href="#" color="success">Success</button>
        <button href="#" color="danger">Danger</button>
        <button href="#" color="warning">Warning</button>
        <button href="#" color="info">Info</button>
        <button href="#" color="light">Light</button>
        <button href="#" color="dark">Dark</button>
      </p>
      <p>Outline</p>
      <p>
        <button href="#" color="primary" outline="yes">Primary</button>
        <button href="#" color="secondary" outline="yes">Secondary</button>
        <button href="#" color="success" outline="yes">Success</button>
        <button href="#" color="danger" outline="yes">Danger</button>
        <button href="#" color="warning" outline="yes">Warning</button>
        <button href="#" color="info" outline="yes">Info</button>
        <button href="#" color="light" outline="yes">Light</button>
        <button href="#" color="dark" outline="yes">Dark</button>
      </p>
      <p>Sizes</p>
      <p>
        <button href="#" size="large">Large button</button>
        <button href="#">Default button</button>
        <button href="#" size="small">Small button</button>
      </p>
      <p>Button group</p>
      <button-group>
        <button href="#">Left</button>
        <button href="#">Middle</button>
        <button href="#">Right</button>
      </button-group>

    <section id="tables">
      <title>Tables</title>
    </section>
      <table striped="yes" frame="all">
        <tgroup cols="4">
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Column heading</entry>
              <entry>Column heading</entry>
              <entry>Column heading</entry>
            </row>
          </thead>
          <tbody>
            <row><entry>Default</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="primary"><entry>Primary</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="secondary"><entry>Secondary</entry><entry>Column content</entry><entry
            >Column content</entry><entry>Column content</entry></row>
            <row color="success"><entry>Success</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="danger"><entry>Danger</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="warning"><entry>Warning</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="info"><entry>Info</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="light"><entry>Light</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
            <row color="dark"><entry>Dark</entry><entry>Column content</entry><entry>Column content</entry><entry
            >Column content</entry></row>
          </tbody>
        </tgroup>
      </table>

